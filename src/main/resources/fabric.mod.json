{
  "schemaVersion": 1,
  "id": "carbonclient",
  "version": "${version}",
  "name": "Carbon Client",
  "description": "Client-only HUD, visual, and quality-of-life modules.",
  "authors": ["Carbon Client"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.carbon.client.CarbonClient"]
  },
  "mixins": [
    {
      "config": "carbonclient.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": ">=0.161.0"
  }
}
